# ReLoop Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# AWS Credentials (required for Bedrock, S3, DynamoDB, EventBridge, Step Functions)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# AWS Bedrock Model ID
AWS_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Phase 1: Storage & Database (Amazon S3 & DynamoDB)
AWS_S3_BUCKET_NAME=reroute-evidence-storage
AWS_DYNAMODB_LOTS_TABLE=ReRoute_Lots
AWS_DYNAMODB_PASSPORTS_TABLE=ReRoute_Passports

# Phase 2: Workflow & Event Bus (AWS Step Functions & Amazon EventBridge)
AWS_EVENTBRIDGE_BUS_NAME=reroute-event-bus
AWS_STEP_FUNCTIONS_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:ReRouteLotProcessingPipeline

# Application
NODE_ENV=development
PORT=3000
