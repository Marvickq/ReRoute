# ReLoop Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# AWS Credentials (required for Bedrock AI analysis)
# Get these from AWS IAM User or AWS CLI configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# AWS Bedrock Model ID (optional, defaults to anthropic.claude-3-5-sonnet-20241022-v2:0)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Application
NODE_ENV=development
PORT=3000
